# Paraguay Frontier — Apache configuration for Hostinger shared hosting.
# Only directives that are reliably available on Hostinger's Apache are used.

Options -Indexes -MultiViews
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 2. One canonical hostname: non-www. Change both lines together if the
    #    canonical host is ever switched to www.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # 3. Trailing slash on directory URLs, so /guides/tax and /guides/tax/ never
    #    both resolve. Files keep their extension.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,6}|/)$
    RewriteRule ^(.*)$ /$1/ [R=301,L]

    # 4. Internal directories are never reachable over HTTP.
    RewriteRule ^(app|config|docs|tools)(/|$) - [F,L]
</IfModule>

ErrorDocument 404 /errors/404/
ErrorDocument 500 /errors/500/

# --- Deny direct access to internal PHP, belt and braces ---------------------
<FilesMatch "^(bootstrap|helpers|page-renderer|seo|schema|form-security)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(md|csv|json|lock|example\.php)$">
    Require all denied
</FilesMatch>

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    # No third-party scripts ship today. Widen this only when analytics is added.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
    Header unset X-Powered-By
</IfModule>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Caching -----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 6 months"
    ExpiresByType image/webp              "access plus 6 months"
    ExpiresByType image/avif              "access plus 6 months"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|css|js|svg|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
